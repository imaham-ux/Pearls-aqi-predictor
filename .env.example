# GEMINI_API_KEY: Required for Gemini AI API calls (health advisor insights).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLASK_API_URL: where the REAL Python ML backend is running.
# Run it separately with: cd python-backend && python app/flask_api.py
# (Defaults to http://127.0.0.1:5001 if not set.)
FLASK_API_URL="http://127.0.0.1:5001"

# NOTE: AQICN_TOKEN, OPENWEATHER_API_KEY, HOPSWORKS_API_KEY, HOPSWORKS_PROJECT_NAME
# are now configured in python-backend/.env (NOT here) - see python-backend/.env.example.
# This Node server no longer calls those APIs directly; it proxies everything
# through the Flask backend above, which owns those real API credentials.
