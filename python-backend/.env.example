# ---------- REQUIRED: Air Quality / Weather APIs ----------
# Get a FREE token in ~30 seconds at: https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# Get a FREE key at: https://openweathermap.org/api  (Air Pollution API + Weather API)
OPENWEATHER_API_KEY=your_openweather_key_here

# ---------- City / location settings ----------
CITY_NAME=karachi
LATITUDE=24.8607
LONGITUDE=67.0011

# ---------- Feature Store: Hopsworks (FREE tier) ----------
# Create a free project at https://app.hopsworks.ai -> Account Settings -> API Keys
# If left empty, the pipeline automatically falls back to a local parquet-based
# feature store at ./data/ so the whole project still runs end-to-end for free.
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=

# ---------- Alerts (optional) ----------
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_APP_PASSWORD=
SLACK_WEBHOOK_URL=
